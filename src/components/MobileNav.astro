---
const links = [
  { href: '/services', label: 'Services' },
  { href: '/service-areas', label: 'Service Areas' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/about', label: 'About' },
  { href: '/request-service', label: 'Request Service', primary: true },
];
---

<div class="mobile-nav" data-mobile-nav>
  <button
    type="button"
    class="mobile-nav__toggle"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    data-mobile-nav-toggle
  >
    <span class="mobile-nav__icon" aria-hidden="true"></span>
    <span class="sr-only">Open menu</span>
  </button>

  <div class="mobile-nav__backdrop" data-mobile-nav-backdrop hidden></div>

  <div
    id="mobile-nav-panel"
    class="mobile-nav__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-nav-title"
    data-mobile-nav-panel
    hidden
  >
    <p id="mobile-nav-title" class="mobile-nav__title">Menu</p>
    <nav aria-label="Mobile">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class={link.primary ? 'btn btn-primary' : 'mobile-nav__link'}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" class="btn btn-accent" data-open-lead data-location="mobile_nav">
            Build a Website Like This
          </button>
        </li>
      </ul>
    </nav>
  </div>
</div>

<script>
  const root = document.querySelector('[data-mobile-nav]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-mobile-nav-panel]');
    const backdrop = root.querySelector<HTMLElement>('[data-mobile-nav-backdrop]');
    const label = toggle?.querySelector('.sr-only');
    let lastFocus: HTMLElement | null = null;

    function focusables() {
      return panel
        ? Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        : [];
    }

    function setOpen(open: boolean) {
      if (!toggle || !panel || !backdrop || !label) return;
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      backdrop.hidden = !open;
      panel.classList.toggle('is-open', open);
      label.textContent = open ? 'Close menu' : 'Open menu';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        lastFocus = document.activeElement as HTMLElement | null;
        focusables()[0]?.focus();
      } else {
        lastFocus?.focus();
      }
    }

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });
    backdrop?.addEventListener('click', () => setOpen(false));
    panel?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a, [data-open-lead]')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (panel?.hidden) return;
      if (event.key === 'Escape') {
        setOpen(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .mobile-nav {
    display: block;
  }
  @media (min-width: 1024px) {
    .mobile-nav {
      display: none;
    }
  }
  .mobile-nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.625rem;
    border: 1px solid #d7e0ea;
    background: #fff;
    color: #0b1f33;
    cursor: pointer;
  }
  .mobile-nav__icon,
  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .mobile-nav__icon::before {
    top: -6px;
  }
  .mobile-nav__icon::after {
    top: 6px;
  }
  .mobile-nav__backdrop {
    position: fixed;
    inset: 0;
    background: rgb(11 31 51 / 0.45);
    z-index: 70;
  }
  .mobile-nav__panel {
    position: fixed;
    top: 0;
    right: 0;
    width: min(22rem, 100%);
    height: 100%;
    background: #fff;
    z-index: 80;
    padding: 1.25rem;
    transform: translateX(100%);
    transition: transform 220ms ease;
    overflow-y: auto;
  }
  .mobile-nav__panel.is-open {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__panel {
      transition: none;
    }
  }
  .mobile-nav__title {
    margin: 0 0 1rem;
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.35rem;
    color: #0b1f33;
  }
  .mobile-nav__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .mobile-nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    text-decoration: none;
    font-weight: 700;
    color: #0b1f33;
  }
  .mobile-nav__panel .btn {
    width: 100%;
  }
</style>
