---
import { siteConfig } from '../config/site';
---

<div
  id="portfolio-bar"
  class="portfolio-bar"
  role="region"
  aria-labelledby="portfolio-bar-label"
  data-storage-key="northline-portfolio-bar-dismissed"
>
  <div class="portfolio-bar__inner">
    <p id="portfolio-bar-label" class="portfolio-bar__copy">
      <span class="portfolio-bar__rocket" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 3c2.5 2 4 5.2 4 9.2 0 1.4-.2 2.7-.6 3.8L12 21l-3.4-5c-.4-1.1-.6-2.4-.6-3.8C8 8.2 9.5 5 12 3z"></path>
          <path d="M9.2 14.5 5 16.2l1.5-3.8M14.8 14.5 19 16.2l-1.5-3.8"></path>
          <circle cx="12" cy="10" r="1.2"></circle>
        </svg>
      </span>
      <span>
        <strong>Portfolio concept by Che Xu Studio.</strong>
        Conversion-focused home-services website concept. NorthLine Home Services is a fictional
        demonstration.
      </span>
    </p>
    <div class="portfolio-bar__actions">
      <a
        class="btn portfolio-bar__btn portfolio-bar__btn--case"
        href={siteConfig.cheXu.caseStudyUrl}
        data-analytics="case_study_selected"
      >
        View Case Study
      </a>
      <button
        type="button"
        class="btn btn-accent portfolio-bar__btn"
        data-open-lead
        data-location="portfolio_bar"
      >
        Build a Website Like This
      </button>
      <button type="button" class="portfolio-bar__dismiss" data-dismiss-bar>Dismiss</button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const bar = document.getElementById('portfolio-bar');
    if (!bar) return;
    const key = bar.getAttribute('data-storage-key') || '';
    try {
      if (localStorage.getItem(key) === '1') bar.hidden = true;
    } catch {
      /* private mode */
    }
  })();
</script>
<script>
  const bar = document.getElementById('portfolio-bar');
  const key = bar?.getAttribute('data-storage-key') || '';
  bar?.querySelector('[data-dismiss-bar]')?.addEventListener('click', () => {
    try {
      localStorage.setItem(key, '1');
    } catch {
      /* ignore */
    }
    if (bar) bar.hidden = true;
  });
</script>

<style>
  .portfolio-bar {
    position: relative;
    z-index: 1;
    background: #0b1f33;
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .portfolio-bar[hidden] {
    display: none !important;
  }
  .portfolio-bar__inner {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0.45rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    justify-content: space-between;
  }
  .portfolio-bar__copy {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.35;
    max-width: 46rem;
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .portfolio-bar__rocket {
    color: #f5a623;
    display: inline-flex;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }
  .portfolio-bar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .portfolio-bar__btn {
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
  }
  .portfolio-bar__btn--case {
    background: #fff;
    color: #0b1f33;
    border-color: #fff;
  }
  .portfolio-bar__btn--case:hover,
  .portfolio-bar__btn--case:focus-visible {
    background: #eaf3ff;
  }
  .portfolio-bar__dismiss {
    min-height: 40px;
    min-width: 44px;
    border: 0;
    background: transparent;
    color: rgb(255 255 255 / 0.85);
    text-decoration: underline;
    cursor: pointer;
    font: inherit;
  }
  /* Keep the NorthLine header (hamburger) near the top on phones. */
  @media (max-width: 639px) {
    .portfolio-bar__inner {
      padding: 0.4rem 0;
      gap: 0.4rem;
    }
    .portfolio-bar__copy {
      font-size: 0.78rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .portfolio-bar__btn {
      min-height: 36px;
      padding: 0.3rem 0.6rem;
      font-size: 0.78rem;
    }
  }
</style>
