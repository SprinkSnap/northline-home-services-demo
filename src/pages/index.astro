---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import RequestFlowPreview from '../components/RequestFlowPreview.astro';
import { services } from '../content/services';
import { homeFaqs } from '../content/faqs';
import { serviceAreaGuidance, serviceAreaGroups } from '../content/areas';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Reliable Home Comfort, Without the Runaround"
  description={siteConfig.description}
  path="/"
>
  <section class="hero hero--photo">
    <div class="hero__media" aria-hidden="true">
      <img
        class="hero__photo"
        src="/images/hero-home-dusk.png"
        alt=""
        width="1536"
        height="1024"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container-nl hero__grid">
      <div class="hero__copy reveal">
        <p class="eyebrow hero__eyebrow">Home Comfort Services</p>
        <h1 class="display hero__title">Reliable Home Comfort, Without the Runaround.</h1>
        <p class="hero__support">
          A clear, mobile-first service experience designed to save you time and keep your home
          comfortable in every season.
        </p>
        <ul class="hero__trust">
          <li>
            <span class="hero__trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <span>Trusted Professionals</span>
          </li>
          <li>
            <span class="hero__trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
            </span>
            <span>On-Time Service</span>
          </li>
          <li>
            <span class="hero__trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 10V5.5a1.5 1.5 0 0 0-3 0V10"/><path d="M11 10V4.5a1.5 1.5 0 0 0-3 0V12"/><path d="M8 12V8.5a1.5 1.5 0 0 0-3 0V14c0 3.5 2.5 6 6 6h1.5c3 0 4.5-1.5 5.5-3l1.7-3.2A2 2 0 0 0 17.9 11H14"/></svg>
            </span>
            <span>Satisfaction Guaranteed</span>
          </li>
        </ul>
        <div class="hero__ctas">
          <a class="btn btn-primary hero__cta" href="/request-service">Request Service →</a>
          <a class="btn hero__secondary hero__cta" href="/services">Explore Services →</a>
        </div>
      </div>
    </div>
    <div class="hero-features" aria-label="Service highlights">
      <div class="hero-features__card">
        <div class="hero-features__grid">
          <div>
            <span class="hero-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/></svg>
            </span>
            <strong>Local &amp; Family Owned</strong>
          </div>
          <div>
            <span class="hero-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 2.8 8.2 5.2 4 4.2v7.3c0 4.4 3.2 7.6 8 8.5 4.8-.9 8-4.1 8-8.5V4.2l-4.2 1-3.8-2.4z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <strong>Licensed &amp; Insured</strong>
          </div>
          <div>
            <span class="hero-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="7.5" cy="9" r="2.4"/><circle cx="16.5" cy="9" r="2.4"/><circle cx="12" cy="13.8" r="2.2"/><path d="M3.2 19c.7-2 2.2-3.2 4.3-3.2.8 0 1.5.2 2.1.5M14.4 16.3c.6-.3 1.3-.5 2.1-.5 2.1 0 3.6 1.2 4.3 3.2"/></svg>
            </span>
            <strong>5-Star Rated Service</strong>
          </div>
          <div>
            <span class="hero-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>
            </span>
            <strong>24/7 Scheduling</strong>
          </div>
          <div>
            <span class="hero-features__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <strong>Serving Your Community</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-nl" aria-labelledby="services-chooser">
    <div class="container-nl">
      <p class="eyebrow">Service chooser</p>
      <h2 id="services-chooser" class="display section-title">What Can We Help With?</h2>
      <p class="lead">Four clear service paths with explore and request actions on every card.</p>
      <div class="grid-services" style="margin-top:1.5rem;">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section-nl process" aria-labelledby="process-title">
    <div class="container-nl">
      <p class="eyebrow">Trust through process</p>
      <h2 id="process-title" class="display section-title">
        A Better Service Experience Starts With Clarity.
      </h2>
      <p class="lead">
        This is a demonstration of the customer journey—not a claim about real dispatch times or
        guarantees.
      </p>
      <ol class="process__steps">
        <li>
          <strong>Tell us what you need</strong><span
            >Choose a service category in plain language.</span
          >
        </li>
        <li>
          <strong>Choose a convenient time</strong><span
            >Share timing preferences without fake urgency.</span
          >
        </li>
        <li>
          <strong>Review your request</strong><span
            >Confirm details before any real submission.</span
          >
        </li>
        <li>
          <strong>Receive confirmation</strong><span
            >See how reassurance and next steps can look.</span
          >
        </li>
      </ol>
    </div>
  </section>

  <section class="section-nl conversion" aria-labelledby="conversion-title">
    <div class="container-nl conversion__panel surface">
      <p class="eyebrow">For business owners</p>
      <h2 id="conversion-title" class="display section-title">
        Designed to Turn Local Searches Into Qualified Enquiries.
      </h2>
      <ul class="conversion__list">
        <li>Clear service navigation</li>
        <li>Mobile conversion actions</li>
        <li>Local-search page architecture</li>
        <li>Guided quote requests</li>
        <li>Fast-loading pages</li>
        <li>Accessible forms</li>
        <li>Conversion analytics without personal data</li>
        <li>Structured service information</li>
      </ul>
      <button type="button" class="btn btn-accent" data-open-lead
        >I Want This for My Business</button
      >
    </div>
  </section>

  <section class="section-nl" aria-labelledby="highlights-title">
    <div class="container-nl">
      <p class="eyebrow">Service highlights</p>
      <h2 id="highlights-title" class="display section-title">
        Benefit-focused service storytelling.
      </h2>
      <div class="highlights">
        {
          services.map((service) => (
            <article>
              <h3>{service.name}</h3>
              <p>{service.summary}</p>
              <a href={`/services/${service.slug}`}>Explore {service.shortName}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-nl" aria-labelledby="demo-request-title">
    <div class="container-nl">
      <p class="eyebrow">Service-request demonstration</p>
      <h2 id="demo-request-title" class="sr-only">Try the request flow</h2>
      <RequestFlowPreview />
    </div>
  </section>

  <section class="section-nl areas" aria-labelledby="areas-title">
    <div class="container-nl">
      <p class="eyebrow">Service-area architecture</p>
      <h2 id="areas-title" class="display section-title">{serviceAreaGuidance.heading}</h2>
      <p class="lead">{serviceAreaGuidance.intro}</p>
      <div class="areas__grid">
        {
          serviceAreaGroups.map((group) => (
            <article class="surface">
              <h3>{group.name}</h3>
              <p>{group.summary}</p>
              <p>
                <strong>Example communities:</strong> {group.exampleCommunities.join(', ')}
              </p>
            </article>
          ))
        }
      </div>
      <p class="areas__note">{serviceAreaGuidance.templateNote}</p>
      <a class="btn btn-secondary" href="/service-areas">See service-area approach</a>
    </div>
  </section>

  <FaqList faqs={homeFaqs} />

  <section class="section-nl final-cta" aria-labelledby="final-cta-title" id="case-study-copy">
    <div class="container-nl final-cta__panel">
      <p class="eyebrow" style="color:#F5A623;">Che Xu Studio</p>
      <h2 id="final-cta-title" class="display">
        Imagine This Conversion System Built for Your Business.
      </h2>
      <p>
        Che Xu Studio designs fast, search-ready websites that make it easier for customers to
        understand your services, trust your business and take the next step.
      </p>
      <div class="final-cta__actions">
        <button type="button" class="btn btn-accent" data-open-lead>Get My Website Plan</button>
        <a class="btn btn-secondary" href={siteConfig.cheXu.packagesUrl}
          >View Che Xu Studio Packages</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('[data-open-lead]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('northline:open-lead-drawer', { detail: { source: 'homepage' } }),
      );
    });
  });
</script>

<style>
  .hero--photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(90vh, 52rem);
    padding: clamp(2.75rem, 7vw, 4.5rem) 0 0;
  }
  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
    display: block;
    filter: brightness(1.14) contrast(1.06) saturate(1.12);
    animation: hero-zoom 12s ease-out both;
  }
  .hero__shade {
    background: linear-gradient(
      180deg,
      rgb(8 22 38 / 0.1) 0%,
      rgb(8 22 38 / 0.2) 28%,
      rgb(8 22 38 / 0.42) 58%,
      rgb(8 22 38 / 0.68) 100%
    );
  }
  .hero__grid {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: flex-end;
    padding-bottom: 1.5rem;
  }
  .hero__copy {
    max-width: 38rem;
    width: 100%;
  }
  .hero__eyebrow {
    color: #f5a623;
    letter-spacing: 0.1em;
  }
  .hero__title {
    color: #fff;
    font-size: clamp(2.2rem, 7.2vw, 3.55rem);
    margin: 0.5rem 0 0.85rem;
    line-height: 1.08;
    text-wrap: balance;
    animation: rise-in 700ms ease both;
  }
  .hero__support {
    color: rgb(255 255 255 / 0.92);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 34rem;
    animation: rise-in 850ms ease both;
  }
  .hero__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0;
    margin: 1.4rem 0 0;
    list-style: none;
    color: #fff;
  }
  .hero__trust li {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
    font-size: clamp(0.72rem, 2.6vw, 0.9rem);
    font-weight: 650;
    line-height: 1.25;
  }
  .hero__trust-icon {
    color: #f5a623;
    display: inline-flex;
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 1.4rem 0 0;
    animation: rise-in 1s ease both;
  }
  .hero__cta {
    width: 100%;
    justify-content: center;
    min-height: 3.15rem;
    border-radius: 0.75rem;
    font-weight: 700;
  }
  .hero__secondary {
    background: transparent;
    color: #f5a623;
    border: 1.5px solid #f5a623;
  }
  .hero__secondary:hover,
  .hero__secondary:focus-visible {
    background: rgb(245 166 35 / 0.12);
  }
  .hero-features {
    position: relative;
    z-index: 2;
    padding: 0 0.85rem;
  }
  .hero-features__card {
    background: #fff;
    border-radius: 1.25rem 1.25rem 0 0;
    box-shadow: 0 -12px 32px rgb(8 22 38 / 0.2);
    padding: 1.1rem 0.5rem 1.25rem;
  }
  .hero-features__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.85rem 0;
  }
  .hero-features__grid > div {
    grid-column: span 2;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
    color: var(--color-midnight);
    font-size: 0.78rem;
    line-height: 1.25;
    padding: 0 0.4rem;
  }
  .hero-features__grid > div:nth-child(1),
  .hero-features__grid > div:nth-child(2) {
    border-right: 1px solid #d7e0ea;
  }
  .hero-features__grid > div:nth-child(4) {
    grid-column: 2 / span 2;
    border-right: 1px solid #d7e0ea;
  }
  .hero-features__grid > div:nth-child(5) {
    grid-column: 4 / span 2;
  }
  .hero-features__icon {
    color: #176bff;
    display: inline-flex;
  }
  @media (min-width: 768px) {
    .hero__ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .hero__cta {
      width: auto;
      min-width: 13rem;
    }
    .hero-features {
      padding: 0 1.25rem;
    }
    .hero-features__card {
      padding: 1.25rem 0.75rem 1.4rem;
    }
    .hero-features__grid > div {
      font-size: 0.9rem;
    }
  }
  @media (min-width: 1024px) {
    .hero--photo {
      min-height: min(86vh, 46rem);
      padding: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    }
    .hero__grid {
      align-items: center;
      padding-bottom: 2.25rem;
    }
    .hero__photo {
      object-position: 72% center;
      filter: brightness(1.16) contrast(1.07) saturate(1.14);
    }
    .hero__shade {
      background: linear-gradient(
        90deg,
        rgb(8 22 38 / 0.9) 0%,
        rgb(11 31 51 / 0.7) 34%,
        rgb(11 31 51 / 0.28) 52%,
        rgb(11 31 51 / 0.05) 70%,
        transparent 100%
      );
    }
    .hero__copy {
      max-width: 34rem;
    }
    .hero__trust {
      max-width: 30rem;
      justify-items: start;
    }
    .hero__trust li {
      justify-items: start;
      text-align: left;
    }
    .hero-features {
      padding: 0;
    }
    .hero-features__card {
      border-radius: 0;
      box-shadow: none;
      border-top: 1px solid #d7e0ea;
      padding: 1.2rem 0;
    }
    .hero-features__grid {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
    }
    .hero-features__grid > div,
    .hero-features__grid > div:nth-child(4),
    .hero-features__grid > div:nth-child(5) {
      grid-column: auto;
      border-right: 0;
      padding: 0.25rem 0.75rem;
    }
    .hero-features__grid > div + div {
      border-left: 1px solid #d7e0ea;
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }
  .section-title {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    margin: 0.35rem 0 0.75rem;
  }
  .process {
    background: rgb(234 243 255 / 0.55);
  }
  .process__steps {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 768px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .process__steps li {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    display: grid;
    gap: 0.35rem;
  }
  .process__steps strong {
    color: var(--color-midnight);
  }
  .process__steps span {
    color: var(--color-muted);
  }
  .conversion__panel {
    padding: 1.5rem;
  }
  .conversion__list {
    display: grid;
    gap: 0.45rem 1rem;
    margin: 1rem 0 1.25rem;
    padding-left: 1.1rem;
  }
  @media (min-width: 768px) {
    .conversion__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .highlights {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .highlights {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .highlights article {
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }
  .highlights h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    color: var(--color-midnight);
  }
  .highlights p {
    margin: 0 0 0.6rem;
    color: var(--color-muted);
  }
  .highlights a {
    color: var(--color-trust-dark);
    font-weight: 700;
  }
  .areas__grid {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0;
  }
  @media (min-width: 768px) {
    .areas__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .areas__grid article {
    padding: 1rem;
  }
  .areas__grid h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    color: var(--color-midnight);
  }
  .areas__note {
    color: var(--color-muted);
    max-width: 48rem;
  }
  .final-cta__panel {
    background: var(--color-midnight);
    color: #fff;
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .final-cta__panel .display {
    color: #fff;
    margin: 0.4rem 0 0.85rem;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }
  .final-cta__panel p {
    color: rgb(255 255 255 / 0.85);
    max-width: 42rem;
  }
  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }
  .final-cta__actions .btn-secondary {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }
</style>
