---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../content/services';
---

<BaseLayout
  title="Home Services Overview"
  description="Explore heating and cooling, plumbing, electrical, and home maintenance service pages in this Che Xu Studio portfolio concept."
  path="/services"
>
  <section class="section-nl">
    <div class="container-nl">
      <Breadcrumbs
        items={[
          { name: 'Home', path: '/' },
          { name: 'Services', path: '/services' },
        ]}
      />
      <p class="eyebrow">Service architecture</p>
      <h1 class="display page-title">Services Designed for Clear Decisions</h1>
      <p class="lead">
        Each service page is built around search intent, plain-language categories, and a guided
        next step—without fake reviews, licences, or emergency pressure tactics.
      </p>
      <div class="grid-services" style="margin-top:1.75rem;">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="/request-service">Start Request Demo</a>
        <button type="button" class="btn btn-accent" data-open-lead
          >Build a Website Like This</button
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('[data-open-lead]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('northline:open-lead-drawer', { detail: { source: 'services' } }),
      );
    });
  });
</script>

<style>
  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.35rem 0 0.85rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }
</style>
