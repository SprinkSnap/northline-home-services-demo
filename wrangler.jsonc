{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "name": "northline-home-services-demo",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northline-portfolio-leads",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Optional Workers AI binding for the demo assistant.
  // Uncomment when deploying to an account with Workers AI enabled:
  // "ai": { "binding": "AI" },
  "vars": {
    "PUBLIC_DEMO_MODE": "true",
    "PUBLIC_SITE_URL": "https://northline.chexustudio.example",
  },
}
