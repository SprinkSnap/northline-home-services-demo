{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "name": "northline-home-services-demo",
  // Virtual entry for `astro dev` / Vite plugin. Not a deployable Worker file by itself.
  // After `astro build`, deploy with the generated config:
  //   npx wrangler deploy --config dist/server/wrangler.json
  // or: npm run cf:deploy
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // D1 is optional for the marketing site deploy.
  // A placeholder database_id causes Cloudflare deploy to fail with code 10181.
  // After creating a real database, uncomment and set the real database_id:
  //
  //   npx wrangler d1 create northline-portfolio-leads
  //   npx wrangler d1 migrations apply northline-portfolio-leads --remote
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "northline-portfolio-leads",
  //     "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  // Optional Workers AI binding for the demo assistant.
  // Uncomment when deploying to an account with Workers AI enabled:
  // "ai": { "binding": "AI" },
  "vars": {
    "PUBLIC_DEMO_MODE": "true",
    "PUBLIC_SITE_URL": "https://northline.chexustudio.example",
  },
}
